# Dev/build container: node as the runtime the installed tools (tsc, the test
# runner) execute under, Deno as the package manager and task runner so npm —
# and npm lifecycle scripts — are never invoked.
#
# Keep the Deno version in step with the sheetrender repo's Dockerfiles.
FROM node:22-bookworm-slim

COPY --from=denoland/deno:bin-2.9.8@sha256:87522ebf680b22dc868397ca9d66f21e8de39a73e7fe918c43cd775dad5c92ae /deno /usr/local/bin/deno
