{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    // Named explicitly: Deno's node_modules symlinks every package into .deno/,
    // and tsc's automatic @types discovery does not follow that layout — without
    // this, node builtins and globals (process, Buffer) fail to resolve.
    "types": ["node"],
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true
  },
  "include": ["src"],
  // Browser code for the MCP Apps view: type-checked by tsconfig.widget.json
  // and bundled by scripts/build-widget.mjs, never emitted by this project.
  "exclude": ["src/widget"]
}
